DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ryzenpanel
JWT_SECRET=replace_with_a_long_secret_value
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
NEXT_PUBLIC_BASE_URL=http://localhost:3000
AUTH_COOKIE_NAME=ryzenpanel_token
NODE_ENV=development
DAEMON_PORT=8080
DAEMON_HTTP_HOST=0.0.0.0
DAEMON_API_KEY=your_daemon_api_key_change_in_production
DAEMON_FILES_ROOT=/var/lib/ryzenpanel/servers
DOCKER_SOCKET_PATH=/var/run/docker.sock
